  <!-- joints - main serial chain -->
  <joint name="ra_base_link_base_link_inertia" type="fixed">
    <parent link="ra_base_link"/>
    <child link="ra_base_link_inertia"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="ra_shoulder_pan_joint" type="revolute">
    <parent link="ra_base_link_inertia"/>
    <child link="ra_shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1519"/>
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <!-- <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/> -->
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ra_shoulder_lift_joint" type="revolute">
    <parent link="ra_shoulder_link"/>
    <child link="ra_upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="56.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <!-- <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/> -->
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ra_elbow_joint" type="revolute">
    <parent link="ra_upper_arm_link"/>
    <child link="ra_forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.24365 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <!-- <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-2.991592653589793" soft_upper_limit="2.991592653589793"/> -->
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ra_wrist_1_joint" type="revolute">
    <parent link="ra_forearm_link"/>
    <child link="ra_wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.21325 0 0.11235"/>
    <axis xyz="0 0 1"/>
    <limit effort="12.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="6.283185307179586"/>
    <!-- <safety_controller k_position="20" k_velocity="0.0" soft_lower_limit="-6.133185307179586" soft_upper_limit="6.133185307179586"/> -->
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="ra_wrist_2_joint" type="revolute">
    <parent link="ra_wrist_1_link"/>
    <child link="ra_wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.08535 -1.750557762378351e-11"/>
    <axis xyz="0 0 1"/>
